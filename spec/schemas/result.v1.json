{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:phoenix:result:v1",
  "title": "ReplayResult",
  "description": "A replay result (one moment, one plan).",
  "type": "object",
  "required": [
    "phoenix_result",
    "plan",
    "check",
    "ledger_entry",
    "start",
    "samples",
    "tiebreak_ran",
    "verdict",
    "discount"
  ],
  "properties": {
    "phoenix_result": {
      "const": 1,
      "description": "Major version of this format."
    },
    "plan": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Plan hash."
    },
    "check": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Check hash."
    },
    "ledger_entry": {
      "type": "object",
      "required": [
        "phoenix_ledger",
        "moment",
        "revision",
        "how",
        "who",
        "at"
      ],
      "properties": {
        "phoenix_ledger": {
          "const": 1
        },
        "moment": {
          "type": "string",
          "description": "Moment id."
        },
        "revision": {
          "type": "string",
          "description": "Moment revision."
        },
        "lock_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "A SHA-256 digest, written sha256:<64 hex digits>."
        },
        "result_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "A SHA-256 digest, written sha256:<64 hex digits>."
        },
        "how": {
          "enum": [
            "approved",
            "auto",
            "accepted",
            "pass-accepted"
          ]
        },
        "who": {
          "type": "string"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "how": {
                "const": "pass-accepted"
              }
            }
          },
          "then": {
            "required": [
              "result_hash"
            ]
          },
          "else": {
            "required": [
              "lock_hash"
            ]
          }
        }
      ]
    },
    "start": {
      "enum": [
        "beginning",
        "mark"
      ]
    },
    "samples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "sample",
          "tiebreak",
          "status",
          "attempts",
          "expectations"
        ],
        "properties": {
          "sample": {
            "type": "integer",
            "minimum": 0
          },
          "tiebreak": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "unassessed"
            ]
          },
          "discounted": {
            "type": "boolean"
          },
          "leaned_on_made_up": {
            "type": "boolean",
            "description": "True when this sample's pass or fail rests on a made-up tool answer: every expectation that decided it came after one."
          },
          "answers": {
            "type": "object",
            "description": "Where each tool answer in the sample's last attempt came from.",
            "required": [
              "session",
              "files_copy",
              "working_copy",
              "made_up",
              "made_up_calls"
            ],
            "properties": {
              "session": {
                "type": "integer",
                "minimum": 0,
                "description": "Answered from the session's own recorded results."
              },
              "files_copy": {
                "type": "integer",
                "minimum": 0,
                "description": "Run for real inside the box, on the copy of the project's files."
              },
              "working_copy": {
                "type": "integer",
                "minimum": 0,
                "description": "Answered by a service's working copy, such as the calendar plugin."
              },
              "made_up": {
                "type": "integer",
                "minimum": 0,
                "description": "Made up by the simulator LLM. Never real."
              },
              "made_up_calls": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "connector",
                    "op"
                  ],
                  "properties": {
                    "connector": {
                      "type": "string"
                    },
                    "op": {
                      "type": "string"
                    }
                  }
                }
              },
              "after_untaken_write_calls": {
                "description": "Answers that came after a write to the same service that its working copy could not take, so the write got a made-up answer. Neither the session nor the copy knows what the service would say then.",
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "connector",
                    "op"
                  ],
                  "properties": {
                    "connector": {
                      "type": "string"
                    },
                    "op": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "attempts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "attempt",
                "status"
              ],
              "properties": {
                "attempt": {
                  "type": "integer",
                  "minimum": 0
                },
                "status": {
                  "enum": [
                    "running",
                    "interrupted",
                    "finished"
                  ]
                },
                "cause": {
                  "type": "string"
                }
              }
            }
          },
          "expectations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "expectation",
                "outcome",
                "tainted"
              ],
              "properties": {
                "expectation": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Index into the check's expect list."
                },
                "outcome": {
                  "enum": [
                    "pass",
                    "fail",
                    "error"
                  ]
                },
                "tainted": {
                  "type": "boolean"
                },
                "error": {
                  "type": "string"
                }
              }
            }
          },
          "intent": {
            "type": "object",
            "required": [
              "met",
              "reason"
            ],
            "properties": {
              "met": {
                "type": "boolean"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "tiebreak_ran": {
      "type": "boolean"
    },
    "leaned_on_made_up": {
      "type": "boolean",
      "description": "True when a sample that counts toward the verdict passed or failed on a made-up tool answer."
    },
    "files_copy": {
      "type": "object",
      "description": "Which copy of the project's files the box used.",
      "required": [
        "source",
        "taken_at"
      ],
      "properties": {
        "source": {
          "enum": [
            "git",
            "today",
            "mark"
          ],
          "description": "git: as committed at the moment's time. today: as the files were when the moment was made. mark: as saved at the mark."
        },
        "commit": {
          "type": "string"
        },
        "taken_at": {
          "type": "string",
          "format": "date-time"
        },
        "left_out": {
          "type": "integer",
          "minimum": 0,
          "description": "How many files Phoenix could not read when it made the copy. They are missing inside the box."
        }
      }
    },
    "baseline": {
      "type": "object",
      "required": [
        "pass",
        "fail",
        "unassessed"
      ],
      "properties": {
        "pass": {
          "type": "integer",
          "minimum": 0
        },
        "fail": {
          "type": "integer",
          "minimum": 0
        },
        "unassessed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "meets_check": {
      "type": "boolean"
    },
    "improved": {
      "type": "boolean"
    },
    "verdict": {
      "enum": [
        "fails",
        "meets-check",
        "incomplete"
      ]
    },
    "discount": {
      "type": "object",
      "required": [
        "discounted"
      ],
      "properties": {
        "discounted": {
          "type": "boolean"
        },
        "confirmed": {
          "enum": [
            "stateful-fake",
            "fresh-recording",
            "pass-accepted"
          ],
          "description": "How a discounted verdict was confirmed. Absent while unconfirmed."
        }
      }
    },
    "fidelity_grade": {
      "enum": [
        "stateful",
        "recorded",
        "synthesized",
        "blocked"
      ]
    }
  }
}
