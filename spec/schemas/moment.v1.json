{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:phoenix:moment:v1",
  "title": "MomentManifest",
  "description": "A moment manifest (moment.yaml).",
  "type": "object",
  "required": [
    "phoenix_moment",
    "id",
    "source"
  ],
  "properties": {
    "phoenix_moment": {
      "const": 1,
      "description": "Major version of this format."
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "enum": [
        "snapshot",
        "scenario"
      ]
    },
    "run": {
      "type": "object",
      "required": [
        "capture"
      ],
      "properties": {
        "capture": {
          "type": "string"
        },
        "task": {
          "type": "string",
          "description": "Task key; empty or absent when the capture is one run."
        }
      }
    },
    "mark": {
      "type": "string",
      "minLength": 1,
      "description": "An event id within a capture."
    },
    "start": {
      "enum": [
        "beginning",
        "mark"
      ],
      "description": "Default start point."
    },
    "clock": {
      "type": "object",
      "required": [
        "time",
        "timezone"
      ],
      "properties": {
        "time": {
          "type": "string",
          "format": "date-time"
        },
        "timezone": {
          "type": "string"
        }
      }
    },
    "prompt": {
      "type": "string"
    },
    "workdir": {
      "type": "string",
      "description": "Reference to the working-directory snapshot under data/workdir/."
    },
    "model": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "The model identifier as the provider reported it."
        },
        "alias": {
          "type": "boolean",
          "description": "True when id is an alias rather than a pinned model."
        },
        "parameters": {
          "type": "object",
          "description": "Model parameters.",
          "additionalProperties": true
        }
      }
    },
    "harness": {
      "type": "object",
      "required": [
        "name",
        "tree"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "tree": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "A SHA-256 digest, written sha256:<64 hex digits>."
        },
        "commit": {
          "type": "string"
        }
      }
    },
    "recipe_version": {
      "type": "string"
    },
    "connectors": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "surface",
          "routes",
          "tier",
          "origin"
        ],
        "properties": {
          "surface": {
            "enum": [
              "mcp",
              "cli",
              "http"
            ]
          },
          "routes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tier": {
            "enum": [
              "stateful",
              "recorded",
              "synthesized",
              "blocked"
            ]
          },
          "origin": {
            "enum": [
              "captured",
              "seeded"
            ]
          },
          "coverage": {
            "type": "object",
            "description": "The connector's coverage statement.",
            "additionalProperties": true
          },
          "read_only": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "op",
                "source"
              ],
              "properties": {
                "op": {
                  "type": "string"
                },
                "source": {
                  "enum": [
                    "plugin",
                    "annotation",
                    "http-safe-method"
                  ],
                  "description": "Anything but plugin is unverified."
                }
              }
            }
          },
          "plugin": {
            "type": "object",
            "required": [
              "name",
              "version"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "version": {
                "type": "string",
                "description": "Version range."
              }
            }
          },
          "tools": {
            "type": "array",
            "description": "The recorded tool list.",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "mcp": {
            "type": "object",
            "properties": {
              "protocol_version": {
                "type": "string"
              },
              "era": {
                "type": "string"
              }
            }
          },
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "kind"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "run-evidence",
                    "capture-time",
                    "confirmation"
                  ]
                }
              }
            }
          },
          "allow_synthesized": {
            "type": "boolean",
            "description": "Allow the simulator for this connector. Off unless set."
          },
          "repeat_reads": {
            "type": "boolean",
            "description": "Set false to turn off answering read-only calls with the last current observation."
          },
          "skip_resolvers": {
            "type": "array",
            "items": {
              "enum": [
                "recorded",
                "overlay",
                "emulator",
                "prefetch",
                "simulator",
                "world"
              ]
            },
            "description": "Answer-chain steps removed for this connector."
          }
        }
      }
    },
    "fills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "tag",
          "basis",
          "producer"
        ],
        "properties": {
          "path": {
            "type": "string",
            "description": "The fill file under data/fills/."
          },
          "tag": {
            "enum": [
              "derived",
              "synthesized"
            ]
          },
          "basis": {
            "type": "object",
            "properties": {
              "rule": {
                "type": "string",
                "description": "Name of the mechanical derivation rule."
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Evidence locations the fill rests on."
              }
            }
          },
          "producer": {
            "type": "string"
          }
        }
      }
    },
    "executable": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Custom-check files, named as executable content."
    },
    "lock": {
      "const": "auto",
      "description": "Lock without approval. Seeded scenarios only."
    },
    "include_ignored": {
      "type": "boolean"
    },
    "packed": {
      "type": "object",
      "required": [
        "from"
      ],
      "description": "Set on a packed revision.",
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "Hash of the revision this was packed from."
        },
        "scrubbed": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Locations scrubbed of personal data."
        },
        "withheld": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "at",
              "size",
              "reason"
            ],
            "properties": {
              "at": {
                "type": "string"
              },
              "size": {
                "type": "integer",
                "minimum": 0
              },
              "reason": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "resume": {
      "type": "object",
      "required": [
        "recipe",
        "session",
        "moment"
      ],
      "description": "Set when the moment resumes the harness's own session file. The recipe cuts the session and resumes it in the box.",
      "properties": {
        "recipe": {
          "type": "string",
          "minLength": 1,
          "description": "Name of the recipe that resumes this session."
        },
        "session": {
          "type": "string",
          "description": "Bundle path of the copied session file."
        },
        "moment": {
          "type": "string",
          "description": "Bundle path of the recipe's reading of the session at the moment: the cut, the prompt, the LLM, the tool loadout and the recorded tool answers."
        },
        "files": {
          "type": "string",
          "description": "Bundle folder holding the copied files beside the session that the cut needs."
        },
        "project": {
          "type": "object",
          "required": [
            "tar",
            "root",
            "source",
            "taken_at"
          ],
          "description": "A copy of the project's files, laid out at the same folder inside the box. File reads and writes the session never made run for real on this copy.",
          "properties": {
            "tar": {
              "type": "string",
              "description": "Bundle path of the copy, as a tar file."
            },
            "root": {
              "type": "string",
              "minLength": 1,
              "description": "The project's folder on the machine where the session ran. The copy sits at this path inside the box."
            },
            "source": {
              "enum": [
                "git",
                "today",
                "mark"
              ],
              "description": "git: the folder's files as committed at the moment's time. today: the folder's files as they were when the moment was made. mark: the folder's files as saved at the mark."
            },
            "commit": {
              "type": "string",
              "description": "The commit the copy came from, when source is git."
            },
            "taken_at": {
              "type": "string",
              "format": "date-time",
              "description": "When the files in the copy were current."
            },
            "more": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Bundle paths of more tar files, when the copy is too big for one. Unpack them after tar, into the same folder."
            },
            "left_out": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Files left out of the copy: files Phoenix could not read, and, in a folder outside git, dot-files, dot-folders such as .ssh, and node_modules. They are missing inside the box."
            },
            "bytes": {
              "type": "integer",
              "minimum": 0,
              "description": "Size of the copy's tar files in the bundle, in bytes."
            },
            "files": {
              "type": "integer",
              "minimum": 0,
              "description": "Number of files in the copy."
            }
          }
        },
        "files_not_copied": {
          "type": "string",
          "description": "Why the project's files were not copied, such as a session that ran in the home folder or a folder over the size cap. New file calls then get the next answer instead."
        },
        "from_beginning": {
          "type": "boolean",
          "description": "The replay starts at the session's first message, with its original prompt."
        },
        "changed_answers": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "description": "Session lines of recorded tool answers that a person changed before the replay."
        },
        "made_up": {
          "type": "boolean",
          "description": "The moment never happened live. A person wrote its messages and its world."
        },
        "marked": {
          "type": "object",
          "required": [
            "at",
            "world"
          ],
          "description": "Set when the moment came from phoenix mark.",
          "properties": {
            "at": {
              "type": "string",
              "format": "date-time",
              "description": "When the mark was made."
            },
            "note": {
              "type": "string"
            },
            "world": {
              "type": "object",
              "required": [
                "files",
                "services"
              ],
              "description": "What the mark saved of the world at that time.",
              "properties": {
                "files": {
                  "enum": [
                    "saved",
                    "not saved"
                  ],
                  "description": "saved: a copy of the project's files as they were at the mark."
                },
                "services": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  },
                  "description": "Per service with a working copy, saved or why not."
                }
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source": {
            "const": "snapshot"
          }
        }
      },
      "then": {
        "required": [
          "run",
          "mark"
        ]
      }
    },
    {
      "if": {
        "required": [
          "lock"
        ]
      },
      "then": {
        "properties": {
          "source": {
            "const": "scenario"
          }
        }
      }
    }
  ]
}
