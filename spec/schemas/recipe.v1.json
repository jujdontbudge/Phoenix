{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:phoenix:recipe:v1",
  "title": "RecipeDescriptor",
  "description": "A capture recipe (recipe.yaml).",
  "type": "object",
  "required": [
    "phoenix_recipe",
    "name",
    "harness_versions",
    "routes"
  ],
  "properties": {
    "phoenix_recipe": {
      "const": 1,
      "description": "Major version of this format."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "harness_versions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "login_modes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "versions",
          "login_mode",
          "surfaces"
        ],
        "properties": {
          "versions": {
            "type": "string"
          },
          "login_mode": {
            "type": "string"
          },
          "surfaces": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": "Routes offered, by surface."
          }
        }
      }
    },
    "mcp": {
      "type": "object",
      "required": [
        "file",
        "format"
      ],
      "properties": {
        "file": {
          "type": "string"
        },
        "format": {
          "type": "string"
        }
      }
    },
    "shim": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "CLI commands to shim."
    },
    "transcript_reader": {
      "type": "object",
      "required": [
        "command",
        "harness_versions"
      ],
      "properties": {
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "A command as an argv array, never a joined shell string."
        },
        "harness_versions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    },
    "task_keys": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "header"
            ],
            "properties": {
              "header": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "meta"
            ],
            "properties": {
              "meta": {
                "type": "string",
                "description": "A field in a request's _meta."
              }
            }
          },
          {
            "type": "object",
            "required": [
              "json_path"
            ],
            "properties": {
              "json_path": {
                "type": "string",
                "description": "A JSON path in model requests."
              }
            }
          }
        ]
      }
    },
    "image": {
      "type": "string",
      "description": "Sandbox image."
    },
    "clock": {
      "type": "object",
      "required": [
        "probe"
      ],
      "properties": {
        "probe": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "A command as an argv array, never a joined shell string."
        },
        "dont_fake_monotonic": {
          "type": "boolean"
        }
      }
    },
    "copy_ignored": {
      "type": "boolean"
    },
    "resume": {
      "type": "object",
      "required": [
        "moment",
        "login",
        "image",
        "command",
        "llm_hosts"
      ],
      "description": "How to put this harness back in a moment by resuming its own session file.",
      "properties": {
        "moment": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "Host command, run in the recipe directory: reads the session file on stdin, takes --at <line> or --from-beginning, and --change <line>=<file> for each tool answer to change, then prints the session moment JSON."
        },
        "login": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "Host command, run in the recipe directory: given a box directory and the LLM provider, writes a box-only copy of the harness's own login there."
        },
        "image": {
          "type": "string",
          "description": "Dockerfile, relative to the recipe, for the box image with the harness installed."
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "Command run inside the box."
        },
        "locate": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "Host command, run in the recipe directory: given --cwd <folder>, prints the path of the session file the harness is writing for that folder. phoenix mark uses it."
        },
        "compose": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "Host command, run in the recipe directory: reads a made-up moment as JSON on stdin and prints a session file whose last turn is the prompt."
        },
        "from_beginning_only": {
          "type": "boolean",
          "description": "The harness has no resume command. Its replays always start again from the first message."
        },
        "llm_hosts": {
          "type": "object",
          "description": "Per LLM provider, the hosts the box may reach directly. Nothing from Phoenix sits between the harness and these hosts.",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?!/)(?!.*\\.\\.)[^*]*(/\\*)?$"
          },
          "minItems": 1,
          "description": "Files beside the session file that the session needs, relative to its folder; a trailing * matches every file in that folder. Phoenix copies them with secrets stripped, leaves out any it can't scan, and passes their folder to the moment command as --files <dir>. The moment command names the ones the cut needs in its files list."
        }
      }
    }
  }
}
