{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:phoenix:harness:v1",
  "title": "HarnessContract",
  "description": "A harness contract (phoenix.harness.yaml).",
  "type": "object",
  "required": [
    "phoenix_harness",
    "name",
    "run",
    "editable"
  ],
  "properties": {
    "phoenix_harness": {
      "const": 1,
      "description": "Major version of this format."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "run": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "command"
          ],
          "properties": {
            "command": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "description": "A command as an argv array, never a joined shell string."
            },
            "output": {
              "type": "string"
            },
            "build": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "description": "A command as an argv array, never a joined shell string."
            },
            "image": {
              "type": "object",
              "required": [
                "dockerfile"
              ],
              "properties": {
                "dockerfile": {
                  "type": "string"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "serve",
            "ready",
            "submit"
          ],
          "properties": {
            "serve": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "description": "A command as an argv array, never a joined shell string."
            },
            "ready": {
              "type": "object",
              "required": [
                "http"
              ],
              "properties": {
                "http": {
                  "type": "string",
                  "description": "e.g. GET /health"
                }
              }
            },
            "submit": {
              "type": "object",
              "required": [
                "http"
              ],
              "properties": {
                "http": {
                  "type": "object",
                  "required": [
                    "method",
                    "path"
                  ],
                  "properties": {
                    "method": {
                      "type": "string"
                    },
                    "path": {
                      "type": "string"
                    },
                    "body": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "build": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "description": "A command as an argv array, never a joined shell string."
            },
            "image": {
              "type": "object",
              "required": [
                "dockerfile"
              ],
              "properties": {
                "dockerfile": {
                  "type": "string"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "resume"
          ],
          "properties": {
            "resume": {
              "type": "object",
              "description": "The harness is put back in a moment by resuming the moment's own session file with its recipe. It needs no endpoints."
            }
          }
        }
      ]
    },
    "endpoints": {
      "type": "object",
      "required": [
        "model"
      ],
      "properties": {
        "model": {
          "type": "object",
          "required": [
            "env"
          ],
          "properties": {
            "env": {
              "type": "string",
              "description": "The environment variable the harness reads its LLM's base URL from. A replay sets it to the URL in the replay settings and lets the box reach that host directly."
            }
          }
        },
        "mcp": {
          "type": "object",
          "required": [
            "file",
            "format"
          ],
          "properties": {
            "file": {
              "type": "string"
            },
            "format": {
              "type": "string"
            }
          }
        }
      }
    },
    "editable": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "Globs of editable paths."
    }
  },
  "if": {
    "properties": {
      "run": {
        "type": "object",
        "required": [
          "resume"
        ]
      }
    }
  },
  "else": {
    "required": [
      "endpoints"
    ]
  }
}
